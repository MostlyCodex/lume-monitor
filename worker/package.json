{
  "name": "lume-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker, Vue 3 dashboard, and deployment tools for Lume.",
  "scripts": {
    "manage": "node ../tools/lumectl.mjs manage",
    "demo:build": "node ../tools/build-demo.mjs",
    "setup:adopt": "node ../tools/lumectl.mjs adopt",
    "node:apply": "node ../tools/lumectl.mjs node apply",
    "node:restore": "node ../tools/lumectl.mjs node restore",
    "doctor": "node ../tools/lumectl.mjs doctor",
    "setup": "node ../tools/lumectl.mjs setup",
    "deploy": "npm run build:frontend && wrangler deploy",
    "dev": "npm run build:frontend && wrangler dev",
    "db:local": "wrangler d1 migrations apply lume --local",
    "monitor:status": "node ../tools/lumectl.mjs status",
    "node:add": "node ../tools/lumectl.mjs node add",
    "node:configure": "node ../tools/lumectl.mjs node configure",
    "node:install": "node ../tools/lumectl.mjs node install",
    "node:remove": "node ../tools/lumectl.mjs node remove",
    "node:revoke": "node ../tools/lumectl.mjs node revoke",
    "node:sync": "node ../tools/lumectl.mjs node sync-keys",
    "preview:dashboard": "npm run build:frontend && node test/dashboard-preview-server.mjs",
    "check": "npm run build:frontend && tsc --noEmit && npm run check:frontend && npm --prefix .. run check:format && node --check test/integration.mjs && node --check test/run-local-integration.mjs && node --test ../tools/test/*.test.mjs && vitest run",
    "test": "npm run build:frontend && vitest run",
    "test:integration": "npm run build:frontend && node test/run-local-integration.mjs",
    "test:browser": "npm run build:frontend && playwright test",
    "test:ci": "npm run check && node test/run-local-integration.mjs && playwright test",
    "build:frontend": "node ../tools/build-frontend.mjs",
    "check:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "dev:frontend": "vite --config frontend/vite.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "uplot": "1.6.32",
    "vue": "3.5.42"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
