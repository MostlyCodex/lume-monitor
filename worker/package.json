{
  "name": "yuanshan-monitor-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && node --check public/dashboard/app.js && node --check test/integration.mjs && vitest run",
    "test": "vitest run",
    "preview:dashboard": "node test/dashboard-preview-server.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply yuanshan-monitor --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "uplot": "1.6.32"
  }
}
